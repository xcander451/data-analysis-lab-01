            "\n",
            "==================================================\n",
            "ЗАДАНИЕ 1. Типы шкал измерения\n",
            "==================================================\n",
            "\n",
            "Типы шкал для каждого признака:\n",
            "age                  : абсолютная\n",
            "job                  : номинальная\n",
            "marital              : номинальная\n",
            "education            : порядковая\n",
            "default              : номинальная\n",
            "housing              : номинальная\n",
            "loan                 : номинальная\n",
            "contact              : номинальная\n",
            "month                : номинальная\n",
            "day_of_week          : номинальная\n",
            "duration             : абсолютная\n",
